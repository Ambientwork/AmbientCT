# =============================================================================
# AmbientCT — Environment Configuration
# =============================================================================
# Copy this to .env and customize before first run:
#   cp .env.example .env
#
# IMPORTANT: Generate a secure password before deploying!
#   openssl rand -base64 16
# =============================================================================

# === Orthanc PACS Server =====================================================

# HTTP API port (browser access to Orthanc Explorer)
ORTHANC_HTTP_PORT=8042

# DICOM DIMSE port (for receiving images from dental equipment via C-STORE)
# Configure your CBCT/OPG scanner to send to this port
ORTHANC_DICOM_PORT=4242

# Orthanc admin credentials (used for API access and OHIF authentication)
# REQUIRED: Change the password before first use!
ORTHANC_USER=admin
ORTHANC_PASSWORD=changeme-on-first-run

# DICOM Application Entity Title (identifies this PACS on the network)
# Must match the AE Title configured on your dental imaging equipment
DICOM_AE_TITLE=DENTALPACS

# Human-readable name shown in the Orthanc web interface
ORTHANC_INSTANCE_NAME=AmbientCT

# Allow overwriting existing DICOM instances (true = update on re-import)
ORTHANC_OVERWRITE_INSTANCES=true

# Time (seconds) before a study is considered stable (no new images expected)
ORTHANC_STABLE_AGE=60

# Maximum results returned by DICOM queries (increase for large archives)
ORTHANC_LIMIT_FIND_RESULTS=100
ORTHANC_LIMIT_FIND_INSTANCES=100

# Number of HTTP worker threads (increase for concurrent users)
ORTHANC_HTTP_THREADS=10

# === OHIF Viewer ==============================================================

# Port for the OHIF web viewer (open http://localhost:3000 in your browser)
VIEWER_PORT=3000

# OHIF Docker image version (pin to avoid breaking changes)
OHIF_VERSION=v3.9.2

# === Resource Limits ==========================================================
# Adjust based on your server hardware. Rendering happens in the browser (GPU),
# so server resources are mainly for DICOM storage and API serving.

# Orthanc: handles DICOM parsing, indexing, and DICOMweb API
ORTHANC_MEM_LIMIT=512m
ORTHANC_CPUS=1.0

# Viewer: serves static files only (React app + Cornerstone3D)
VIEWER_MEM_LIMIT=256m
VIEWER_CPUS=0.5

# MAR-Processor: Python-Service für Metal Artifact Reduction
# Erhöhe MAR_MEM_LIMIT und MAR_CPUS auf leistungsfähiger Hardware für schnellere Verarbeitung.
# Typische Verarbeitungszeit: ~30-90 Sekunden pro CBCT-Serie (400 Slices, 512×512)
MAR_PORT=8000
MAR_MEM_LIMIT=1g
MAR_CPUS=2.0

# === Logging ==================================================================
# Docker JSON log driver settings — prevents unbounded log growth

# Maximum size per log file before rotation
LOG_MAX_SIZE=10m

# Number of rotated log files to keep
LOG_MAX_FILE=3

# === CORS (Security) ==========================================================
# Comma-separated list of allowed origins for cross-origin requests.
# Leave empty or omit to allow same-origin only (recommended for LAN).
# Example for production with Nginx: CORS_ALLOWED_ORIGINS=https://pacs.praxis.local
CORS_ALLOWED_ORIGINS=

# === Nginx (production only) ==================================================
# Uncomment and configure when enabling the Nginx reverse proxy service
# in docker-compose.yml for HTTPS/SSL termination.
# IMPORTANT: Never serve patient data over plain HTTP in production!

# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# SSL_CERT_PATH=./config/nginx/ssl/cert.pem
# SSL_KEY_PATH=./config/nginx/ssl/key.pem

# === AI Inference Service (Phase 3b-2 — real DentalSegmentator model) =========
# Hardware target: Apple Silicon M4 Mac mini, 16 GB RAM.
# Container is limited to 8 GB; peak inference RSS is ~4–6 GB on CPU/MPS.

# Memory + CPU limits for the FastAPI inference container.
# 8g is the hard ceiling for the M4 Mac mini clinical target.
# Increase on larger machines (e.g., 16g on a Mac Studio M2 Ultra).
AI_INFERENCE_MEM_LIMIT=8g
AI_INFERENCE_CPUS=4.0

# Set to true to enable the AI Assist HTTP backend in the viewer.
# When false, the viewer uses its built-in mock adapter (browser-side localStorage).
AI_INFERENCE_ENABLED=false

# Base URL for the inference service as seen by the viewer's frontend.
# Defaults to relative /api/ai when proxied through the viewer's nginx.
AI_INFERENCE_BASE_URL=/api/ai

# Force the ai-inference service into demo mode: always use the synthetic
# mock predictor, regardless of AI_MODEL_PATH. Mode resolution
# (demo | real | unavailable) is documented in ai-inference/README.md.
AI_INFERENCE_DEMO_MODE=false

# Whether a DEMO (mock) segmentation result is written to Orthanc via
# STOW-RS. Default false: demo results stay in the API's in-memory job
# state only — nothing synthetic is ever persisted to the normal PACS
# instance. Set to true ONLY in an isolated test stack
# (docker-compose.test.yml) so the DICOM SEG write/upload/roundtrip path
# can be exercised end-to-end without real model weights. When true, the
# persisted SEG file itself is marked as synthetic (SeriesDescription
# suffix "[DEMO DATA — Research Preview, Not for Diagnosis]" and
# ManufacturerModelName/SegmentAlgorithmName containing "ambientct-mock-v0")
# so it can never be mistaken for a real result in a PACS browser.
AI_INFERENCE_PERSIST_DEMO_SEG=false

# --- Model selection (Phase 3b-2) -------------------------------------------

# Path to the VALIDATED, UNPACKED nnU-Net model folder inside the container
# (dataset.json + plans.json + fold_*/checkpoint_final.pth) — NOT the .zip.
# The host path ./data/ai-models/ is mounted read-only at /models/.
# Run `bash scripts/download-models.sh` once to download AND unpack the
# weights into this exact folder; `--verify-only` checks it any time
# without touching the network. A .zip path here is rejected with a clear
# "unavailable" reason at both /api/ai/health and job start — it is never
# silently accepted and never reaches nnU-Net directly.
AI_MODEL_PATH=/models/mandibular-canal/Dataset111_453CT_v100

# Inference device: "cpu" (resilient default for the linux/amd64 Docker
# path — plan §3.3) or "mps" (Apple Silicon GPU, native macOS development
# only; MPS is never promised as acceleration inside this container).
# PYTORCH_ENABLE_MPS_FALLBACK=1 is set in docker-compose.yml to handle any
# MPS-unsupported nnU-Net ops when "mps" is used on a native host.
AI_INFERENCE_DEVICE=cpu

# nnU-Net label ID to extract as the mandibular canal from the model's
# 5-class output (0=background 1=maxilla 2=mandible 3=upper teeth
# 4=lower teeth 5=canal — see data/ai-models/mandibular-canal/MODEL_CARD.md
# after running the download script). Defaults to the model's own label
# metadata (5); override only if a different model checkpoint uses a
# different label scheme. A wrong value here does not fail loudly — it
# silently extracts the wrong anatomy.
AI_INFERENCE_CANAL_LABEL=5

# nnU-Net's sliding-window patch size is fixed by the trained model's own
# plans.json and is not a supported runtime override — there is
# deliberately no AI_INFERENCE_PATCH_SIZE variable (removed: it only ever
# reached a log line and never affected inference).
